# Copy to .env:  cp .env.example .env
# These values are shared by docker-compose.yml and the Python code.

# --- MinIO (local S3) -------------------------------------------------------
MINIO_ROOT_USER=klausel-admin
MINIO_ROOT_PASSWORD=change-me-local-only
S3_BUCKET=legal-docs-raw
S3_PREFIX=

# Standard AWS/boto3 variables, pointed at the local MinIO container.
AWS_ACCESS_KEY_ID=klausel-admin
AWS_SECRET_ACCESS_KEY=change-me-local-only
AWS_DEFAULT_REGION=eu-central-1
AWS_ENDPOINT_URL=http://localhost:9000

# --- Qdrant -----------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=legal_docs_de

# --- Embeddings (loaded from ./models, never downloaded at runtime) --------
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
EMBEDDING_MODEL_DIR=./models/multilingual-e5-small
EMBEDDING_DEVICE=auto

# --- Chunking / privacy -----------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
REDACT_PII=true

# --- Ollama -----------------------------------------------------------------
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral:7b-instruct
RETRIEVAL_TOP_K=5

# --- Hard offline switches (enforced again in code) -------------------------
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
ZENML_ANALYTICS_OPT_IN=false

# --- Network ----------------------------------------------------------------
# Interface the containers publish on. Keep 127.0.0.1 on a laptop. On the VM
# hosting MinIO, set it to the VM's private / host-only IP (avoid 0.0.0.0 on
# anything reachable from the internet). Then on the machine running the
# pipeline set AWS_ENDPOINT_URL=http://<vm-ip>:9000.
BIND_ADDR=127.0.0.1
